+    if (self.tabs.count > 0) {
+      for (UITab *tab in self.tabs) {
+        if (tab.viewController == selectedViewController) {
+          self.selectedTab = tab;
+          break;
+        }
+      }
+      if (!_isHandlingExplicitSelectionUpdate) {
+        [self reconcileNavigationStateWithUIKitState];
+      }
+      return;
