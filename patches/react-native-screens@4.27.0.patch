+// iOS 27+: `.tabs` is authoritative for selection.
+- (nullable __kindof UIViewController *)selectedViewController
+{
+  if (@available(iOS 27.0, *)) {
+    if (self.tabs.count > 0) {
+      return self.selectedTab.viewController;
+    }
+  }
+  return [super selectedViewController];
+}
