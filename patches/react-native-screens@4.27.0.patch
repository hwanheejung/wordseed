+// `<Stack.SearchBar>` sets `navigationItem.searchController` on the nested Stack's
+// topViewController, two containment levels below `screenController`. `automaticallyActivatesSearch`
+// only inspects `screenController.navigationItem` itself, so mirror it up.
+- (void)rns_mirrorSearchControllerForTabScreenController:(RNSTabsScreenViewController *)screenController
+    API_AVAILABLE(ios(27.0))
+{
+  UINavigationController *nestedNav = nil;
+  for (UIViewController *child in screenController.childViewControllers) {
+    if ([child isKindOfClass:UINavigationController.class]) {
+      nestedNav = static_cast<UINavigationController *>(child);
+      break;
+    }
+  }
+
+  if (nestedNav == nil || nestedNav.topViewController == nil) {
+    return;
+  }
+
+  UINavigationItem *sourceItem = nestedNav.topViewController.navigationItem;
+  screenController.navigationItem.searchController = sourceItem.searchController;
+  if (sourceItem.searchController != nil) {
+    screenController.navigationItem.preferredSearchBarPlacement = sourceItem.preferredSearchBarPlacement;
+    screenController.navigationItem.hidesSearchBarWhenScrolling = sourceItem.hidesSearchBarWhenScrolling;
+  }
+}
