{
  "name": "wordseed",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vercel dev --listen 5173",
    "dev:web": "vercel dev --listen 5173",
    "dev:web:ui": "turbo run dev --filter=@wordseed/web",
    "dev:api": "turbo run dev --filter=@wordseed/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@wordseed/web",
    "build:api": "turbo run build --filter=@wordseed/api",
    "db:push": "pnpm --filter @wordseed/api db:push",
    "db:seed": "pnpm --filter @wordseed/api db:seed",
    "db:check": "pnpm --filter @wordseed/api db:check",
    "db:studio": "pnpm --filter @wordseed/api db:studio",
    "schema:generate": "pnpm --filter @wordseed/api schema:generate",
    "start:api": "pnpm --filter @wordseed/api start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "structure:check": "turbo run structure:check",
    "verify": "turbo run structure:check typecheck lint test",
    "seed:compat": "pnpm --filter @wordseed/web seed:compat"
  },
  "devDependencies": {
    "turbo": "^2.10.11",
    "vercel": "59.5.0"
  }
}
