{
  "name": "wordseed",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo run dev --filter=@wordseed/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@wordseed/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "structure:check": "turbo run structure:check",
    "verify": "turbo run structure:check typecheck lint test",
    "seed:compat": "pnpm --filter @wordseed/web seed:compat"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
