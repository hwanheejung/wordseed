generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum DictionaryEntryKind {
  WORD
  EXPRESSION
}

enum DictionaryPartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  AUXILIARY
  PARTICLE
}

enum DictionarySenseRelationKind {
  DERIVED_FROM
  ANTONYM
  CONFUSABLE
}

enum DictionarySynsetRelationKind {
  HYPERNYM
  RELATED
}

enum DictionarySenseNarrativeKind {
  STORY
  ORIGIN
  USAGE_GUIDE
}

enum DictionaryFormKind {
  THIRD_PERSON_SINGULAR
  PAST
  PAST_PARTICIPLE
  PRESENT_PARTICIPLE
  PLURAL
  COMPARATIVE
  SUPERLATIVE
  OTHER
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  authSubject           String    @unique @map("auth_subject") @db.Uuid
  nativeLanguageTag     String?   @map("native_language_tag") @db.VarChar(35)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  timeZone              String?   @map("time_zone") @db.VarChar(64)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model DictionaryEntry {
  id          String              @id @default(uuid()) @db.Uuid
  headword    String              @db.VarChar(255)
  languageTag String              @map("language_tag") @db.VarChar(35)
  kind        DictionaryEntryKind
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  senses      DictionarySense[]

  @@unique([languageTag, headword])
  @@map("dictionary_entries")
}

model DictionarySense {
  id                String                     @id @default(uuid()) @db.Uuid
  entryId           String                     @map("entry_id") @db.Uuid
  synsetId          String                     @map("synset_id") @db.Uuid
  entry             DictionaryEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  synset            DictionarySynset           @relation(fields: [synsetId], references: [id], onDelete: Restrict)
  commonnessScore   Float?                     @map("commonness_score")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  narratives        DictionarySenseNarrative[]
  examples          DictionarySenseExample[]
  forms             DictionaryForm[]
  outgoingRelations DictionarySenseRelation[]  @relation("DictionarySenseRelationSource")
  incomingRelations DictionarySenseRelation[]  @relation("DictionarySenseRelationTarget")

  @@unique([entryId, synsetId])
  @@index([entryId, commonnessScore])
  @@index([synsetId])
  @@map("dictionary_senses")
}

model DictionarySynset {
  id                String                       @id @default(uuid()) @db.Uuid
  partOfSpeech      DictionaryPartOfSpeech?      @map("part_of_speech")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  senses            DictionarySense[]
  definitions       DictionarySynsetDefinition[]
  examples          DictionarySynsetExample[]
  outgoingRelations DictionarySynsetRelation[]   @relation("DictionarySynsetRelationSource")
  incomingRelations DictionarySynsetRelation[]   @relation("DictionarySynsetRelationTarget")

  @@map("dictionary_synsets")
}

model DictionarySynsetDefinition {
  id          String           @id @default(uuid()) @db.Uuid
  synsetId    String           @map("synset_id") @db.Uuid
  synset      DictionarySynset @relation(fields: [synsetId], references: [id], onDelete: Cascade)
  languageTag String           @map("language_tag") @db.VarChar(35)
  text        String           @db.Text

  @@unique([synsetId, languageTag])
  @@map("dictionary_synset_definitions")
}

model DictionarySenseNarrative {
  id            String                       @id @default(uuid()) @db.Uuid
  senseId       String                       @map("sense_id") @db.Uuid
  sense         DictionarySense              @relation(fields: [senseId], references: [id], onDelete: Cascade)
  kind          DictionarySenseNarrativeKind
  languageTag   String                       @map("language_tag") @db.VarChar(35)
  markdown      String                       @db.Text
  generatedBy   String?                      @map("generated_by") @db.VarChar(100)
  promptVersion String?                      @map("prompt_version") @db.VarChar(100)
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  @@unique([senseId, kind, languageTag])
  @@map("dictionary_sense_narratives")
}

model DictionarySenseExample {
  id                String                              @id @default(uuid()) @db.Uuid
  senseId           String                              @map("sense_id") @db.Uuid
  sense             DictionarySense                     @relation(fields: [senseId], references: [id], onDelete: Cascade)
  sourceLanguageTag String                              @map("source_language_tag") @db.VarChar(35)
  sourceText        String                              @map("source_text") @db.Text
  translations      DictionarySenseExampleTranslation[]
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")

  @@unique([senseId, sourceLanguageTag, sourceText])
  @@map("dictionary_sense_examples")
}

model DictionarySenseExampleTranslation {
  id          String                 @id @default(uuid()) @db.Uuid
  exampleId   String                 @map("example_id") @db.Uuid
  example     DictionarySenseExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  languageTag String                 @map("language_tag") @db.VarChar(35)
  text        String                 @db.Text
  generatedBy String?                @map("generated_by") @db.VarChar(100)

  @@unique([exampleId, languageTag])
  @@map("dictionary_sense_example_translations")
}

model DictionarySynsetExample {
  id                String                               @id @default(uuid()) @db.Uuid
  synsetId          String                               @map("synset_id") @db.Uuid
  synset            DictionarySynset                     @relation(fields: [synsetId], references: [id], onDelete: Cascade)
  sourceLanguageTag String                               @map("source_language_tag") @db.VarChar(35)
  sourceText        String                               @map("source_text") @db.Text
  translations      DictionarySynsetExampleTranslation[]
  createdAt         DateTime                             @default(now()) @map("created_at")
  updatedAt         DateTime                             @updatedAt @map("updated_at")

  @@unique([synsetId, sourceLanguageTag, sourceText])
  @@map("dictionary_synset_examples")
}

model DictionarySynsetExampleTranslation {
  id          String                  @id @default(uuid()) @db.Uuid
  exampleId   String                  @map("example_id") @db.Uuid
  example     DictionarySynsetExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  languageTag String                  @map("language_tag") @db.VarChar(35)
  text        String                  @db.Text
  generatedBy String?                 @map("generated_by") @db.VarChar(100)

  @@unique([exampleId, languageTag])
  @@map("dictionary_synset_example_translations")
}

model DictionaryForm {
  id      String             @id @default(uuid()) @db.Uuid
  senseId String             @map("sense_id") @db.Uuid
  sense   DictionarySense    @relation(fields: [senseId], references: [id], onDelete: Cascade)
  surface String             @db.VarChar(255)
  kind    DictionaryFormKind

  @@unique([senseId, surface, kind])
  @@map("dictionary_forms")
}

model DictionarySenseRelation {
  id            String                      @id @default(uuid()) @db.Uuid
  sourceSenseId String                      @map("source_sense_id") @db.Uuid
  targetSenseId String                      @map("target_sense_id") @db.Uuid
  kind          DictionarySenseRelationKind
  sourceSense   DictionarySense             @relation("DictionarySenseRelationSource", fields: [sourceSenseId], references: [id], onDelete: Cascade)
  targetSense   DictionarySense             @relation("DictionarySenseRelationTarget", fields: [targetSenseId], references: [id], onDelete: Cascade)

  @@unique([sourceSenseId, targetSenseId, kind])
  @@index([targetSenseId])
  @@map("dictionary_sense_relations")
}

model DictionarySynsetRelation {
  id             String                       @id @default(uuid()) @db.Uuid
  sourceSynsetId String                       @map("source_synset_id") @db.Uuid
  targetSynsetId String                       @map("target_synset_id") @db.Uuid
  kind           DictionarySynsetRelationKind
  sourceSynset   DictionarySynset             @relation("DictionarySynsetRelationSource", fields: [sourceSynsetId], references: [id], onDelete: Cascade)
  targetSynset   DictionarySynset             @relation("DictionarySynsetRelationTarget", fields: [targetSynsetId], references: [id], onDelete: Cascade)

  @@unique([sourceSynsetId, targetSynsetId, kind])
  @@index([targetSynsetId])
  @@map("dictionary_synset_relations")
}
